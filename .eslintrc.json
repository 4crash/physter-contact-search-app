{
    "root": true,
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "project": ["./client/tsconfig.json", "./client/tsconfig.node.json"]
    },
    "plugins": [
        "@typescript-eslint"
    ],
    "extends": [
        "react-app"
    ],
    "rules": {
        "@typescript-eslint/semi": "off"
    },
    "ignorePatterns": ["jest.config.js", "client/vite.config.ts", "server/**"]
}